# Copy to .env and fill in. Never commit .env.

# ---- Vertex AI (model backend) ----
GOOGLE_CLOUD_PROJECT=my-gcp-project
# Must be `global`: gemini-3.8-flash only serves from the global Vertex
# endpoint (404s in regional ones), and the Workspace MCP servers in
# config.MCP_SERVERS are registered in Agent Registry under `global` too —
# a regional value here 403s the Agent Registry lookup, not just the model.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_ACT_MODEL=gemini-3.8-flash

# MINIMAL | LOW | MEDIUM | HIGH, or empty for the model's own default.
# The biggest single lever on reply latency: Gemini 3.x thinks before every
# response, and a turn that calls tools is several responses, so this is paid
# 3-5x per reply. LOW keeps multi-step tool plans working; MINIMAL is faster
# but starts fumbling them. Raise it if answers get shallow.
GEMINI_ACT_THINKING_LEVEL=LOW

# ---- Live (voice) mode ----
# Used only by `agents/live_agent/` — `make voice`, then the microphone in the
# ADK dev UI. Voice needs a Live model: the model above cannot hold a
# bidirectional audio session and will not connect at all in that mode.
#
# gemini-3.1-flash-live-preview is the current one (audio straight in and out,
# no speech-to-text -> LLM -> text-to-speech chain). It is served only by the
# Gemini API (AI Studio) backend. Vertex serves the older, GA
# `gemini-live-2.5-flash-native-audio` instead — switch to that id if you would
# rather stay on Vertex and drop the key below.
GEMINI_ACT_LIVE_MODEL=gemini-3.1-flash-live-preview

# AI Studio key (https://aistudio.google.com/apikey), for the live model only —
# everything else keeps using Vertex with ADC. Falls back to GEMINI_API_KEY /
# GOOGLE_API_KEY if this is unset. Leave empty only when LIVE_MODEL is the
# Vertex id above.
GEMINI_ACT_LIVE_API_KEY=

# Voice: Puck | Charon | Kore | Fenrir | Aoede | Leda | Orus | Zephyr,
# or empty for the model's default.
GEMINI_ACT_LIVE_VOICE=Puck

# BCP-47 code to pin the spoken answer to one language, e.g. ro-RO. Normally
# left empty: the model hears which language it is being spoken to in and
# answers in that one.
GEMINI_ACT_LIVE_LANGUAGE=

# Thinking budget while speaking, separate from THINKING_LEVEL above: thinking
# time that is invisible in Chat is dead air mid-sentence in a conversation.
GEMINI_ACT_LIVE_THINKING_LEVEL=MINIMAL

# TRUE (default): the agent can use Google Search grounding for questions
# outside Workspace and the business tools. No per-user OAuth needed, but each
# search is billed separately on Vertex AI and adds an LLM round trip (it runs
# as its own sub-agent — see agent/tools/search.py).
GEMINI_ACT_WEB_SEARCH_ENABLED=TRUE

# ---- Google Chat webhook ----
# The public HTTPS URL Google Chat posts to. Must match the "HTTP endpoint URL"
# configured on the Chat API page exactly — it is the JWT audience.
# Local dev: your cloudflared/ngrok URL. Deployed: the Cloud Run URL.
GEMINI_ACT_CHAT_AUDIENCE=https://example-abc123-uc.a.run.app

# Set FALSE only for local testing without a real Chat-signed request.
GEMINI_ACT_VERIFY_CHAT_REQUESTS=TRUE

# FALSE (default): answers arrive as ordinary messages in the main window, one
# flat running conversation. TRUE nests each answer under the question, which
# Chat shows as a collapsed thread the reader has to expand.
GEMINI_ACT_CHAT_REPLY_IN_THREAD=FALSE

# TRUE (default): a placeholder goes up the moment you ask and is rewritten in
# place as the model writes, so you watch the answer appear. Chat has no typing
# indicator an app can raise — this is built from spaces.messages.patch.
# FALSE restores one message at the end, and the silence before it.
GEMINI_ACT_CHAT_STREAMING_ENABLED=TRUE
# Minimum seconds between rewrites. Each one is a Chat API write against the
# space's per-minute quota, so this is a rate limit before it is a smoothness
# knob: 1.5s caps a streaming reply at ~40 writes/minute and leaves the space
# room for the humans in it.
GEMINI_ACT_CHAT_STREAM_INTERVAL_SECONDS=1.5

# TRUE (default): a file the user attaches directly to a Chat message is
# downloaded and given to the model inline. Separate from the Drive MCP tool,
# which lets the model find files on its own by name.
GEMINI_ACT_CHAT_ATTACHMENTS_ENABLED=TRUE
# Kept well under Gemini's ~20MB inline request limit — sent as base64, which
# is ~4/3 the raw size. An attachment over this is reported to the user, not
# silently dropped.
GEMINI_ACT_CHAT_ATTACHMENT_MAX_BYTES=15000000
# Each attachment is a live download before the agent can start thinking; this
# bounds how many one message can force onto the critical path.
GEMINI_ACT_CHAT_ATTACHMENT_MAX_COUNT=5

# TRUE (default): the model can attach buttons, images and layout to an
# answer (a small subset of Google's A2UI protocol, rendered onto Cards v2)
# instead of only text — see chat/a2ui.py.
GEMINI_ACT_CHAT_A2UI_ENABLED=TRUE

# TRUE (default): the model can send a file it composed (a small CSV, a text
# report) back as a Chat attachment — see chat/reply_attachment.py. Sent as
# the user, not the app: Chat has no way to upload as the app's own identity,
# so this does nothing for a user who has not run /auth regardless of this
# flag.
GEMINI_ACT_CHAT_REPLY_ATTACHMENTS_ENABLED=TRUE

# ---- MCP servers users connect themselves ----
# Lets anyone paste a remote MCP server (a URL, or a client's JSON config) into
# the chat and use its tools from the next message. Stored per user.
GEMINI_ACT_CUSTOM_MCP_ENABLED=TRUE
GEMINI_ACT_CUSTOM_MCP_MAX_PER_USER=10

# Comma-separated hostnames a pasted server may live on; subdomains of a listed
# host are accepted. Empty means any https host, which is a trust decision: a
# pasted server's tools run in the same agent turn as that user's Workspace
# tools, so a hostile one can see what the agent fetched and can return text
# that tries to steer it. Set this to restrict the feature to servers you vet.
GEMINI_ACT_CUSTOM_MCP_ALLOWED_HOSTS=

# Not optional once the above is on. With client certificates enabled, ADK may
# attach *this service's own* Google credentials to whatever host a user pasted
# (see src/gemini_act/agent/tools/custom_mcp.py). deploy_cloud_run.sh sets it.
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# ---- Per-user OAuth (Workspace MCP servers) ----
# Web application client from Google Auth Platform > Clients.
# Authorized redirect URI must be <public base url>/oauth/callback
GEMINI_ACT_OAUTH_CLIENT_ID=
GEMINI_ACT_OAUTH_CLIENT_SECRET=
GEMINI_ACT_PUBLIC_BASE_URL=https://example-abc123-uc.a.run.app
# Random string used to sign the OAuth `state` parameter.
GEMINI_ACT_STATE_SECRET=change-me-to-something-random

# ---- Storage ----
# firestore | memory
GEMINI_ACT_TOKEN_STORE=firestore
GEMINI_ACT_FIRESTORE_COLLECTION=gemini_act_tokens
# Session persistence. Empty = in-memory (fine locally, lost on restart).
GEMINI_ACT_SESSION_DB_URL=

# ---- Which Workspace MCP servers to expose ----
# Resolved via Cloud Agent Registry — see config.MCP_SERVERS for the full set
# registered for this project: gmail,drive,calendar,chat,people,bigquery,maps,
# storage.
#
# Enable only what you use. Every server here contributes its whole tool list to
# the prompt of every LLM call in a turn, so the full set is both slower to
# answer and more likely to pick the wrong tool (which costs another round trip).
GEMINI_ACT_MCP_ENABLED=gmail,drive,calendar

# ---------------------------------------------------------------------------
# Property search and valuation (imobiliare.ro)
# ---------------------------------------------------------------------------
# The agent can search listings, pull details, summarise a market segment and
# produce a full valuation under the Romanian standards (SEV 2025), including a
# vision pass over the listing photos. Set false to drop all four tools.
GEMINI_ACT_IMOBILIARE_ENABLED=true

# Only `cauta_proprietati` needs this, and imobiliare.ro sessions expire within
# minutes. Capture from a browser: DevTools > Network > /api/search > request
# body > session_id. Valuation and listing lookup need no session at all.
GEMINI_ACT_IMOBILIARE_SESSION_ID=

# Comparables carried into the GEV 630 grid, and how many listing photos are
# sent to the vision model. Each photo is tokens and latency on a call the user
# is waiting on; the first two dozen already cover every room.
GEMINI_ACT_IMOBILIARE_COMPARABLES=12
GEMINI_ACT_IMOBILIARE_MAX_PHOTOS=24

# Let the model actually look at the photographs, the Street View image of the
# block and the area map, and file what it sees in the report. Off leaves the
# report's visual section empty.
GEMINI_ACT_IMOBILIARE_VISION_ENABLED=true
GEMINI_ACT_IMOBILIARE_VISION_MODEL=gemini-3.8-flash

# How politely the portal is asked. These are read by `imobiliare_mcp.throttle`
# under their bare names (no GEMINI_ACT_ prefix), because that package also runs
# standalone as an MCP server.
#
# imobiliare.ro answers an over-eager client with an anti-bot interstitial
# ("Am detectat o anomalie în comportamentul browserului dumneavoastră"),
# served as a 200 with an HTML body. Most of the cure was removing duplicate
# requests rather than slowing down — one listing is now fetched once per run
# however many tools want it — but these are the dials if it happens again:
# raise the interval, lower the parallelism.
#
# MIN_INTERVAL is seconds between two requests to the same host, JITTER is the
# random extra on top, MAX_PARALLEL is how many may be in flight at once across
# the whole process, MEMO_TTL is how long a fetched listing or photograph stays
# usable without re-asking.
IMOBILIARE_MIN_INTERVAL=1.2
IMOBILIARE_JITTER=0.8
IMOBILIARE_MAX_PARALLEL=2
IMOBILIARE_MEMO_TTL=900

# ---------------------------------------------------------------------------
# Google Maps Platform
# ---------------------------------------------------------------------------
# Server-side key used by the valuation for geocoding, nearby amenities with
# ratings, real walking times to the metro, a static map and a Street View
# image of the building. This is NOT the `maps` Workspace MCP server above —
# that one is per-user OAuth and only reachable inside an agent turn, which is
# no use to code running server-side during a valuation.
#
# Empty is supported: everything falls back to OpenStreetMap (Nominatim +
# Overpass), which is free but coarser and much slower.
#
# APIs to enable on the project: Geocoding API, Places API (New), Routes API,
# Maps Static API, Street View Static API.
GEMINI_ACT_MAPS_API_KEY=
GEMINI_ACT_MAPS_AMENITY_RADIUS_M=1200
