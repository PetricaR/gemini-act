# Copy to .env and fill in. Never commit .env.

# ---- Vertex AI (model backend) ----
GOOGLE_CLOUD_PROJECT=my-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_ACT_MODEL=gemini-2.5-flash

# ---- Google Chat webhook ----
# The public HTTPS URL Google Chat posts to. Must match the "HTTP endpoint URL"
# configured on the Chat API page exactly — it is the JWT audience.
# Local dev: your cloudflared/ngrok URL. Deployed: the Cloud Run URL.
GEMINI_ACT_CHAT_AUDIENCE=https://example-abc123-uc.a.run.app

# Set FALSE only for local testing without a real Chat-signed request.
GEMINI_ACT_VERIFY_CHAT_REQUESTS=TRUE

# ---- Per-user OAuth (Workspace MCP servers) ----
# Web application client from Google Auth Platform > Clients.
# Authorized redirect URI must be <public base url>/oauth/callback
GEMINI_ACT_OAUTH_CLIENT_ID=
GEMINI_ACT_OAUTH_CLIENT_SECRET=
GEMINI_ACT_PUBLIC_BASE_URL=https://example-abc123-uc.a.run.app
# Random string used to sign the OAuth `state` parameter.
GEMINI_ACT_STATE_SECRET=change-me-to-something-random

# ---- Storage ----
# firestore | memory
GEMINI_ACT_TOKEN_STORE=firestore
GEMINI_ACT_FIRESTORE_COLLECTION=gemini_act_tokens
# Session persistence. Empty = in-memory (fine locally, lost on restart).
GEMINI_ACT_SESSION_DB_URL=

# ---- Which Workspace MCP servers to expose ----
GEMINI_ACT_MCP_ENABLED=gmail,drive,calendar,chat,docs
